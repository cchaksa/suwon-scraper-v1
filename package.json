{
  "name": "suwon-scraper",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/worker.js",
    "start:worker": "node dist/worker.js",
    "start:server": "node dist/server.js",
    "dev": "ts-node src/worker.ts",
    "dev:worker": "ts-node src/worker.ts",
    "dev:server": "ts-node src/server.ts",
    "test": "npm run build && node --test dist/tests/*.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "playwright-core": "1.41.0",
    "cors": "^2.8.5",
    "@playwright/test": "1.41.2",
    "playwright": "1.41.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.15.30",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.2"
  }
}
