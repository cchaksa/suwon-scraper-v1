{
  "family": "suwon-scraper2",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::445567115863:role/ecsTaskExecutionRole",  
  "containerDefinitions": [
    {
      "name": "suwon-scraper2",
      "image": "${IMAGE_URI}",
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "SCRAPE_CALLBACK_BASE_URL",
          "value": "${SCRAPE_CALLBACK_BASE_URL}"
        },
        {
          "name": "SCRAPE_CALLBACK_TIMEOUT_MS",
          "value": "5000"
        },
        {
          "name": "WORKER_TOTAL_TIMEOUT_MS",
          "value": "120000"
        },
        {
          "name": "WORKER_GRACEFUL_SHUTDOWN_MS",
          "value": "10000"
        },
        {
          "name": "PORTAL_TIMEOUT_MS",
          "value": "60000"
        }
      ],
      "secrets": [
        {
          "name": "SCRAPE_CALLBACK_HMAC_SECRET",
          "valueFrom": "${SCRAPE_CALLBACK_HMAC_SECRET_ARN}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/suwon-scraper2",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
} 
