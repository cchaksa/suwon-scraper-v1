{
  "name": "suwon-scraper",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc",
    "build:runtime": "yarn clean && tsc -p tsconfig.runtime.json",
    "start": "node dist/worker.js",
    "start:worker": "node dist/worker.js",
    "start:server": "node dist/server.js",
    "dev": "ts-node src/worker.ts",
    "dev:worker": "ts-node src/worker.ts",
    "dev:server": "ts-node src/server.ts",
    "test": "yarn build && node --test dist/tests/*.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "express": "^4.18.2",
    "playwright-core": "1.41.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.15.30",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.2"
  }
}
